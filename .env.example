# Copy this file to ".env" and set where form submissions should go.
# Any URL that accepts a JSON POST works, e.g. a Formspree form or your own API.
# Leave it empty while developing: the form will just log the data to the console.
# Create React App only reads variables that start with REACT_APP_.
REACT_APP_FORM_ENDPOINT=https://formspree.io/f/your-form-id
